# Production environment variables (Railway: Project → each service → Variables tab).
# DATABASE_URL and REDIS_URL are injected automatically by Railway's Postgres and Redis
# plugins when you "Add a variable reference" — you don't type those two by hand.

APP_ENV=production
API_KEY=                          # generate: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
PUBLIC_BASE_URL=https://your-domain.example   # or the *.up.railway.app URL Railway gives you first

# --- Providers: start on "fake" (default) so the site is live with no external accounts.
# Swap each to "real" only once that account/app is approved — see DEPLOY.md, "Going real".
LLM_PROVIDER=anthropic             # this one's worth turning on immediately, real drafts need it
ANTHROPIC_API_KEY=sk-ant-...
ENRICHMENT_PROVIDER=fake
SOCIAL_PROVIDER=fake               # fake | linkedin_x
OAUTH_PROVIDER=fake                # fake | real  (gates LinkedIn/X/Outlook connect)
BILLING_PROVIDER=fake              # fake | stripe
MESSAGING_PROVIDER=fake            # fake | twilio  (SMS surface)
TRANSCRIPTION_PROVIDER=fake        # fake | whisper (voice memos)
CALENDAR_PROVIDER=fake             # fake | microsoft
EMAIL_PROVIDER=fake                # fake | microsoft

# --- Secrets for each "real" provider above, filled in as you turn each one on:
# Stripe (billing_provider=stripe)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_FOUNDER=
STRIPE_PRICE_TEAM=
STRIPE_PRICE_GROWTH=
# LinkedIn + X (oauth_provider=real, social_provider=linkedin_x)
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
X_CLIENT_ID=
X_CLIENT_SECRET=
# Microsoft / Outlook (oauth_provider=real, calendar_provider=microsoft, email_provider=microsoft)
MS_CLIENT_ID=
MS_CLIENT_SECRET=
MS_TENANT=common
# Twilio (messaging_provider=twilio)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
# OpenAI Whisper (transcription_provider=whisper)
OPENAI_API_KEY=

# --- Security: MUST be a real, freshly generated key in production — the checked-in default
# in settings.py is dev-only and encrypts nothing that matters if it leaks.
# generate: python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=

# --- Brand (all optional, defaults already match Aime)
SITE_NAME=Aime
SITE_FONT=Figtree
SITE_FONT_WEIGHTS=400;500;600;700;800
FONT_CSS_BASE=https://api.fonts.coollabs.io/css2
